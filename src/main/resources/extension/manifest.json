{
  "manifest_version": 3,
  "name": "JobPilot helper",
  "version": "2.1.0",
  "description": "Scores Naukri and Indeed jobs, queues tailored applications, and fills forms from your JobPilot profile.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.naukri.com/*",
        "https://*.indeed.com/*"
      ],
      "exclude_matches": [
        "https://smartapply.indeed.com/*"
      ],
      "js": [
        "common.js",
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workable.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://smartapply.indeed.com/*"
      ],
      "js": [
        "common.js",
        "apply.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}